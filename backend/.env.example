# =========================================================
# GREENLENS AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials
# =========================================================

PORT=5000

# =========================================================
# 1. REAL EMAIL DELIVERY CONFIGURATION (Choose Option A or B)
# =========================================================

# --- OPTION A: Free Gmail SMTP (Fastest Setup) ---
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. Scroll to 'App passwords' -> Create a new App Password named 'GreenLens'
# 3. Paste your 16-character password below:
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- OPTION B: Custom SMTP Server (Brevo / SendGrid / AWS SES / Outlook) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user@domain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="GreenLens Security" <auth@greenlens.cloud>

# =========================================================
# 2. REAL MOBILE SMS DELIVERY CONFIGURATION (Twilio / Fast2SMS)
# =========================================================

# --- OPTION A: Twilio SMS (Global Delivery) ---
# 1. Sign up at twilio.com (free trial available)
# 2. Copy Account SID and Auth Token from your Console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- OPTION B: Fast2SMS (India / DLT Delivery) ---
# FAST2SMS_API_KEY=your_fast2sms_authorization_key

# =========================================================
# NOTE: If no keys are provided, GreenLens automatically
# runs in safe evaluation mode with automated test inboxes.
# =========================================================
